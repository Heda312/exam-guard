# ExamGuard web tier: serves the SPA and reverse-proxies the API + WebSocket.
#
# Rendered from a template at container start so the upstream host/port come
# from the environment (API_HOST / API_PORT) instead of being hardcoded.
upstream examguard_api {
    server ${API_HOST}:${API_PORT};
    keepalive 32;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Abuse protection for auth/registration endpoints.
limit_req_zone $binary_remote_addr zone=auth_zone:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=register_zone:10m rate=30r/m;

server {
    listen 80;
    server_name _;

    client_max_body_size 4m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # WebSocket endpoints
    location /ws/ {
        proxy_pass http://examguard_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/v1/auth/login {
        limit_req zone=auth_zone burst=10 nodelay;
        proxy_pass http://examguard_api;
        include /etc/nginx/conf.d/proxy_common.inc;
    }

    location /api/v1/participant/register {
        limit_req zone=register_zone burst=20 nodelay;
        proxy_pass http://examguard_api;
        include /etc/nginx/conf.d/proxy_common.inc;
    }

    location /api/ {
        proxy_pass http://examguard_api;
        include /etc/nginx/conf.d/proxy_common.inc;
    }

    location = /health {
        proxy_pass http://examguard_api;
        include /etc/nginx/conf.d/proxy_common.inc;
    }

    # SPA fallback
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    location /assets/ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
