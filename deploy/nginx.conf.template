# ExamGuard web tier: serves the SPA and reverse-proxies the API + WebSocket.
#
# Rendered from a template at container start so the upstream host/port come
# from the environment (API_HOST / API_PORT) instead of being hardcoded.
upstream examguard_api {
    server ${API_HOST}:${API_PORT};
    keepalive 32;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# --- Real client IP behind Cloudflare Tunnel -------------------------------
# Every request arrives from cloudflared, so $remote_addr is the tunnel, not
# the participant. Cloudflare overwrites CF-Connecting-IP at its edge and it
# cannot be spoofed *through the tunnel* — provided the origin port is only
# reachable from localhost (docker-compose binds 127.0.0.1:9200). Trust the
# header only from those private sources; anything else keeps $remote_addr.
set_real_ip_from 127.0.0.1;
set_real_ip_from ::1;
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
real_ip_header CF-Connecting-IP;

# Abuse protection. These are per real client IP now (see real_ip above).
# register_zone: one exam cohort (80+ participants) may sign up in a burst.
limit_req_zone $binary_remote_addr zone=auth_zone:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=register_zone:10m rate=200r/m;

server {
    listen 80;
    server_name _;

    client_max_body_size 4m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Security headers live in a snippet because nginx's add_header is NOT
    # inherited by a location that declares its own add_header (the SPA
    # fallback does). Every location that serves a response includes it.
    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # WebSocket endpoints
    location /ws/ {
        proxy_pass http://examguard_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        # X-Forwarded-For is OVERWRITTEN, not appended: a client-supplied
        # chain must never reach the app (ip spoofing / rate-limit bypass).
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/v1/auth/login {
        limit_req zone=auth_zone burst=10 nodelay;
        proxy_pass http://examguard_api;
        include /etc/nginx/conf.d/proxy_common.inc;
    }

    location /api/v1/participant/register {
        limit_req zone=register_zone burst=100 nodelay;
        proxy_pass http://examguard_api;
        include /etc/nginx/conf.d/proxy_common.inc;
    }

    location /api/ {
        proxy_pass http://examguard_api;
        include /etc/nginx/conf.d/proxy_common.inc;
    }

    location = /health {
        proxy_pass http://examguard_api;
        include /etc/nginx/conf.d/proxy_common.inc;
    }

    # SPA fallback
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
    }

    location /assets/ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
    }
}
