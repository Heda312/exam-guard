# =============================================================================
# ExamGuard — local development environment (no Docker)
#
#   cd backend
#   cp ../.env.local.example .env
#   uvicorn app.main:app --reload --port 8000
#
# Untuk production (Docker + PostgreSQL) gunakan .env.example.
# =============================================================================

APP_ENV=development
PUBLIC_BASE_URL=http://localhost:5173
API_PREFIX=/api/v1

# SQLite, tabel dibuat otomatis saat start
DATABASE_URL=sqlite:///./data/examguard.db
AUTO_CREATE_TABLES=true

# Kunci lokal — JANGAN dipakai di production
SECRET_KEY=dev-only-change-me-please
SETUP_SECRET=dev-setup-secret
SETUP_DISABLED=false

# Admin awal opsional untuk lokal; biarkan kosong agar wizard /setup dipakai.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=

# Cookie: false karena lokal memakai http
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
SESSION_TTL_MINUTES=720
SESSION_COOKIE_NAME=eg_session
CSRF_COOKIE_NAME=eg_csrf
CSRF_HEADER_NAME=X-CSRF-Token

PASSWORD_MIN_LENGTH=10

PARTICIPANT_IDENTITY_MODE=none
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAINS=

DEFAULT_EXAM_DURATION_MINUTES=90
COMMITMENT_VERSION=exam-integrity-v1

HEARTBEAT_INTERVAL_SECONDS=10
HEARTBEAT_TIMEOUT_SECONDS=45
INCIDENT_CORRELATION_MS=400
ALLOWED_EXAM_URL_HOSTS=docs.google.com,forms.gle,forms.google.com

LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_MINUTE=20

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://exam.heda.my.id
EXPIRY_SWEEP_SECONDS=5
