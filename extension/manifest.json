{
  "manifest_version": 3,
  "name": "ExamGuard — Exam Session Monitor",
  "version": "1.3.0",
  "description": "Memantau aktivitas browser selama sesi ujian ExamGuard berlangsung.",
  "minimum_chrome_version": "114",
  "permissions": ["tabs", "storage", "alarms", "scripting"],
  "host_permissions": [
    "https://exam.heda.my.id/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "ExamGuard",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://exam.heda.my.id/*", "http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html"],
      "matches": ["https://exam.heda.my.id/*"]
    }
  ]
}
