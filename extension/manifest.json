{
  "manifest_version": 3,
  "name": "ExamGuard — Exam Session Monitor",
  "version": "1.5.1",
  "description": "Membuka halaman peserta ExamGuard dan memantau aktivitas browser selama ujian berlangsung.",
  "minimum_chrome_version": "114",
  "permissions": ["tabs", "storage", "alarms", "scripting"],
  "host_permissions": [
    "https://exam.heda.my.id/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "https://docs.google.com/*",
    "https://forms.google.com/*",
    "https://forms.gle/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Buka ExamGuard"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://exam.heda.my.id/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://docs.google.com/*",
        "https://forms.google.com/*",
        "https://forms.gle/*"
      ],
      "js": ["focus-watcher.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
