# ---------------------------------------------------------------------------
# ExamGuard environment reference — copy to .env and adjust.
# Local development defaults (SQLite, no external login, insecure cookies).
# ---------------------------------------------------------------------------

# Core
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:5173
API_PREFIX=/api/v1

# Database — SQLite for local dev, PostgreSQL for production
DATABASE_URL=sqlite:///./data/examguard.db
AUTO_CREATE_TABLES=true
# Production example:
# DATABASE_URL=postgresql+psycopg://examguard:CHANGE_ME@db:5432/examguard
# AUTO_CREATE_TABLES=false   (use: alembic upgrade head)

# Secrets — MUST be replaced in production
SECRET_KEY=dev-only-change-me-please
# One-time secret for /setup. Leave empty to disable the setup page entirely.
SETUP_SECRET=dev-setup-secret
# Set true after setup is complete to hard-disable first-run setup.
SETUP_DISABLED=false

# Sessions
SESSION_COOKIE_NAME=eg_session
CSRF_COOKIE_NAME=eg_csrf
CSRF_HEADER_NAME=X-CSRF-Token
SESSION_TTL_MINUTES=720
# false only for http://localhost development
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# Password policy
PASSWORD_MIN_LENGTH=10

# Participant identity
# none   -> Exam ID + normalized roster name only (project default)
# google -> additionally require a verified Google ID token
PARTICIPANT_IDENTITY_MODE=none
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAINS=

# Exam defaults
DEFAULT_EXAM_DURATION_MINUTES=90
COMMITMENT_VERSION=exam-integrity-v1

# Monitoring
HEARTBEAT_INTERVAL_SECONDS=10
HEARTBEAT_TIMEOUT_SECONDS=45
INCIDENT_CORRELATION_MS=400
ALLOWED_EXAM_URL_HOSTS=docs.google.com,forms.gle,forms.google.com

# Rate limiting
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_MINUTE=20

# CORS (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://exam.heda.my.id

# Maintenance worker interval
EXPIRY_SWEEP_SECONDS=5
