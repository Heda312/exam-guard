# =============================================================================
# ExamGuard — environment file
#
#   cp .env.example .env
#   # isi nilai di bawah, lalu:
#   docker compose up -d --build
#
# Semua langkah lain otomatis: entrypoint menunggu database, menjalankan
# migrasi, membuat administrator awal, lalu menyalakan API dan nginx.
# =============================================================================

# ---------------------------------------------------------------------------
# WAJIB DIISI
# ---------------------------------------------------------------------------
# Password database. Dipakai oleh container db DAN API.
# Boleh memakai karakter @ / ? # % — API meng-encode-nya otomatis.
# PENTING: kalau volume db_data sudah pernah dibuat, password baru TIDAK
# berlaku. Kembalikan ke password lama, atau hapus volume (data hilang).
POSTGRES_PASSWORD=ganti-dengan-password-kuat

# Kunci internal server: openssl rand -hex 32
SECRET_KEY=ganti-dengan-hasil-openssl-rand-hex-32

# Origin publik yang dipakai browser. Harus sama dengan URL tunnel Cloudflare.
PUBLIC_BASE_URL=https://exam.heda.my.id

# DATABASE_URL sengaja TIDAK diisi: API merakitnya dari POSTGRES_* di atas.
# Isi hanya jika ingin menimpa (harus sudah URL-encoded).
# DATABASE_URL=

# ---------------------------------------------------------------------------
# ADMINISTRATOR AWAL (dibuat otomatis saat container pertama kali naik)
# ---------------------------------------------------------------------------
# Login staff memakai USERNAME + kata sandi (bukan email).
BOOTSTRAP_ADMIN_ENABLED=true
# Default produksi: heda / WedhusGembel5. GANTI kata sandi ini setelah login.
BOOTSTRAP_ADMIN_USERNAME=heda
# Minimal 10 karakter, harus memuat huruf dan angka.
BOOTSTRAP_ADMIN_PASSWORD=WedhusGembel5
BOOTSTRAP_ADMIN_NAME=Administrator
# Email opsional, hanya informasi kontak (tidak dipakai untuk login).
BOOTSTRAP_ADMIN_EMAIL=

# Bootstrap bersifat idempotent: bila admin sudah ada, nilai di atas diabaikan
# dan API tetap sehat walaupun kata sandi dikosongkan.

# ---------------------------------------------------------------------------
# PORT (host)
# ---------------------------------------------------------------------------
# Port yang dibuka di host. Arahkan Cloudflare Tunnel ke http://127.0.0.1:9200
WEB_PORT=9200
# Port internal container API. Tidak perlu diubah.
API_PORT=8000
# Jumlah worker uvicorn. 1 sudah cukup untuk ~80 peserta bersamaan.
API_WORKERS=1

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
POSTGRES_DB=examguard
POSTGRES_USER=examguard
# Migrasi dijalankan otomatis oleh entrypoint.
RUN_MIGRATIONS=true

# ---------------------------------------------------------------------------
# APLIKASI
# ---------------------------------------------------------------------------
APP_ENV=production
# Harus true bila PUBLIC_BASE_URL memakai https (Cloudflare Tunnel).
# Set false hanya untuk akses LAN lewat http://<ip>:<port>.
COOKIE_SECURE=true
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
SESSION_TTL_MINUTES=720
# CORS otomatis mengikuti PUBLIC_BASE_URL bila dikosongkan.
CORS_ORIGINS=

# Setup wizard berbasis browser tidak diperlukan karena admin dibuat otomatis.
# Biarkan SETUP_DISABLED=true agar /setup tertutup permanen.
SETUP_DISABLED=true
SETUP_SECRET=

# ---------------------------------------------------------------------------
# IDENTITAS PESERTA
# ---------------------------------------------------------------------------
# none   -> Exam ID + nama ternormalisasi saja (default proyek ini)
# google -> wajib verifikasi Google ID token
PARTICIPANT_IDENTITY_MODE=none
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAINS=

# ---------------------------------------------------------------------------
# UJIAN & PEMANTAUAN
# ---------------------------------------------------------------------------
COMMITMENT_VERSION=exam-integrity-v1
ALLOWED_EXAM_URL_HOSTS=docs.google.com,forms.gle,forms.google.com
HEARTBEAT_INTERVAL_SECONDS=10
HEARTBEAT_TIMEOUT_SECONDS=45
INCIDENT_CORRELATION_MS=400
EXPIRY_SWEEP_SECONDS=5

# ---------------------------------------------------------------------------
# BATAS PERCOBAAN
# ---------------------------------------------------------------------------
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Key-nya (IP, exam code). Untuk 80+ peserta yang daftar bersamaan lewat satu
# tunnel, anggaran ini harus menutup satu kohort penuh dalam satu menit.
REGISTER_RATE_LIMIT_PER_MINUTE=200

# ---------------------------------------------------------------------------
# DATABASE POOL (opsional)
# ---------------------------------------------------------------------------
# WebSocket TIDAK lagi menahan koneksi database, jadi nilai default berikut
# sudah menutup beban 80+ peserta (burst registrasi + heartbeat 10 detik).
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=10
# DB_POOL_RECYCLE=1800
